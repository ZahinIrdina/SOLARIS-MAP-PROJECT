rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Old table. No longer used by the app; kept so nothing else breaks.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.role == resource.data.role;
    }

    function signedIn() {
      return request.auth != null;
    }

    // Registering: link a record to the new account. Only allowed while the
    // record's uid is empty, the email on record matches the account's email,
    // and nothing but `uid` changes.
    function claimingRecord() {
      return resource.data.get('uid', '') == ''
        && request.resource.data.uid == request.auth.uid
        && resource.data.email.lower() == request.auth.token.email.lower()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid']);
    }

    // Edit Profile: the owner can change only these three fields.
    function editingOwnRecord() {
      return resource.data.get('uid', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['fullName', 'phone', 'faculty']);
    }

    // Student info table. Document ID = matric number.
    // Created by the exam office (email filled in, uid left empty).
    match /students/{id} {
      allow read: if signedIn();
      allow update: if signedIn() && (claimingRecord() || editingOwnRecord());
    }

    // Lecturer / invigilator info table. Document ID = staff ID.
    match /lecturers/{id} {
      allow read: if signedIn();
      allow update: if signedIn() && (claimingRecord() || editingOwnRecord());
    }
  }
}
